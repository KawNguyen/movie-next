// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
  // url đã chuyển sang prisma.config.ts
}

// Better-auth models

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  accounts     Account[]
  sessions     Session[]
  favorites    Favorite[]
  watchHistory WatchHistory[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([identifier, value])
  @@map("verifications")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  movieId   String   @map("movie_id")
  movieSlug String   @map("movie_slug")
  movieName String   @map("movie_name")
  posterUrl String?  @map("poster_url")
  movieType String?  @map("movie_type")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@map("favorites")
}

model WatchHistory {
  id        String @id @default(cuid())
  userId    String @map("user_id")
  movieId   String @map("movie_id")
  movieSlug String @map("movie_slug")
  movieName String @map("movie_name")
  posterUrl String? @map("poster_url")
  thumbUrl  String? @map("thumb_url")

  totalEpisodes Int? @map("total_episodes")

  // Tập đang xem
  episodeId   String @map("episode_id")
  episodeName String @map("episode_name")
  serverSlug  String @map("server_slug")
  progress    Int    @default(0)
  duration    Int    @default(0)

  // Các tập đã xem xong (union giữa các thiết bị)
  completedEpisodes String[] @default([]) @map("completed_episodes")

  // Client quyết định thời điểm, nên KHÔNG dùng @updatedAt
  updatedAt DateTime @default(now()) @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("watch_history")
}
